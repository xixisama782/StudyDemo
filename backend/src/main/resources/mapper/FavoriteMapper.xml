<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.gamecenter.mapper.FavoriteMapper">

    <select id="selectFavoritedGameIds" resultType="long">
        SELECT f.game_id
        FROM favorites f
        WHERE f.user_id = #{userId}
          AND f.game_id IN
        <foreach collection="gameIds" item="gid" open="(" separator="," close=")">
            #{gid}
        </foreach>
    </select>
</mapper>
