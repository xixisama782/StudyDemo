# =============================================================================
# GameCenter 后端环境变量模板
# 复制为 backend/.env（已 gitignore，勿提交真实密码）
# Spring Boot 不会自动读 .env — 启动前需手动注入（见 ProSteps.md）
# =============================================================================

# -----------------------------------------------------------------------------
# DEVELOPMENT（本地开发，通常可省略）
# -----------------------------------------------------------------------------
# 默认 profile 为 dev（application.yml → application-dev.yml），无需设置：
#   SPRING_PROFILES_ACTIVE=dev
#
# 开发默认值（可被下列变量覆盖）：
#   MySQL  localhost:3306/gamecenter  root/123456
#   Redis  localhost:6379
#   CORS   http://localhost:10109, http://127.0.0.1:10109
#   JWT    内置 dev 密钥（仅本地，勿用于生产）
#
# 可选覆盖示例：
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gamecenter?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=123456
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# GAMECENTER_REDIS_HOME=D:/Redis
#
# SMTP（开发推荐写入 application-local.yml，见 application-local.yml.example）：
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
#
# 无 Redis 应急：--spring.profiles.active=no-redis

# -----------------------------------------------------------------------------
# PRODUCTION（部署必填 — SPRING_PROFILES_ACTIVE=prod）
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gamecenter?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=true
SPRING_DATASOURCE_USERNAME=gamecenter
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MIN_IDLE=5

SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_CACHE_REDIS_TTL=10m

# 生产必须：openssl rand -base64 48
JWT_SECRET_KEY=
JWT_EXPIRATION_MS=86400000

# CORS：逗号分隔的前端正式 Origin（勿使用 *）
APP_CORS_ALLOWED_ORIGINS=https://game.example.com

# SMTP（注册/改密验证码；生产勿写入 application-local.yml）
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
